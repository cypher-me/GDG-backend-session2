// Prisma schema — the data model is the source of truth for the generated client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Placeholder "users" table matching the columns the sample route queries.
// Adjust fields to match the real table (or run `prisma db pull` once you have
// a live DATABASE_URL to introspect it automatically).

// model User {
//  id        Int     @id @default(autoincrement())
//  username  String
//   full_name String?
//   password String
// }

model User {
  id        Int      @id @default(autoincrement())  // PK, auto-increments
  username  String   @unique                       // no two rows share this
  email     String   @unique
  full_name String?
  role      String   @default("user")              // defaults if not supplied
  createdAt DateTime @default(now())               // set automatically
  // Stored as plain text for now — hashing comes in a later step.
  password  String

  // Relation to Task: lets Prisma query a user's tasks (user.tasks).
  tasks     Task[]
}

// "Task" model backing the PROTECTED task routes (see src/routes/tasks.js).
// A task belongs to exactly one user (owner). `role` is not stored here —
// it lives on the User, and authorization is decided from the JWT's role claim.
model Task {
  id        Int      @id @default(autoincrement()) // PK
  title     String                                 // task heading
  description String?                              // optional details
  status    String   @default("pending")           // pending | in_progress | done
  // The id of the user who owns this task. FK -> User.id
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}